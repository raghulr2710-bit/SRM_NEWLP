# Copy to .env.local (development) or set in your hosting provider.
# Never commit real credentials.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL, used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://admissions.example.edu.in
# Set to "false" on staging / preview deployments to block indexing.
NEXT_PUBLIC_ALLOW_INDEXING=true

# ---------------------------------------------------------------------------
# CRM (server-side only – never prefixed with NEXT_PUBLIC_)
# See docs/CRM-INTEGRATION.md
# ---------------------------------------------------------------------------
# "mock" = validate but do not send (UI says so explicitly). "live" = forward to CRM.
# Defaults to "mock" when no endpoint is configured.
CRM_MODE=mock
# "generic" (JSON POST + Bearer token) or "meritto" (access-key / secret-key headers).
CRM_ADAPTER=generic
CRM_ENDPOINT=
CRM_API_KEY=
CRM_SECRET_KEY=
CRM_SOURCE=admissions-lp-2027

# Optional per-institution overrides (KEY = RMP | TRICHY | EEC | TRP)
# CRM_ENDPOINT_RMP=
# CRM_API_KEY_RMP=
# CRM_SECRET_KEY_RMP=
# CRM_ENDPOINT_TRICHY=
# CRM_API_KEY_TRICHY=
# CRM_SECRET_KEY_TRICHY=
# CRM_ENDPOINT_EEC=
# CRM_API_KEY_EEC=
# CRM_SECRET_KEY_EEC=
# CRM_ENDPOINT_TRP=
# CRM_API_KEY_TRP=
# CRM_SECRET_KEY_TRP=

# ---------------------------------------------------------------------------
# Spam protection (optional) – Cloudflare Turnstile
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Google Analytics 4
# ---------------------------------------------------------------------------
# Shared property for all four pages (every event carries an `institution` param)…
NEXT_PUBLIC_GA4_ID=
# …or one property per institution (takes precedence when set).
# NEXT_PUBLIC_GA4_ID_RMP=
# NEXT_PUBLIC_GA4_ID_TRICHY=
# NEXT_PUBLIC_GA4_ID_EEC=
# NEXT_PUBLIC_GA4_ID_TRP=
